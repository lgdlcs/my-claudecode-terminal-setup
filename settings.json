{
  "model": "opus",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm *)"
    ]
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Brewing",
      "Pondering",
      "Marinating",
      "Cogitating",
      "Ruminating",
      "Galaxy-braining",
      "Percolating",
      "Noodling",
      "Vibing",
      "Conjuring"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$OSTYPE\" in darwin*) bash \"$HOME/.claude/terminal-session-color.sh\" >/dev/null 2>&1 || true ;; esac"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/worktree-guard.py\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$OSTYPE\" in darwin*) afplay /System/Library/Sounds/Pop.aiff >/dev/null 2>&1 & ;; msys*|cygwin*) powershell.exe -c \"[console]::beep(880,80)\" >/dev/null 2>&1 & ;; esac; echo '{\"systemMessage\":\"\u2733 Claude Code\"}'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/worktree-guard.py\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
