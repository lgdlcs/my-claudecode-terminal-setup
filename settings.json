{
  "model": "opus",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Brewing",
      "Pondering",
      "Marinating",
      "Cogitating",
      "Ruminating",
      "Galaxy-braining",
      "Percolating",
      "Noodling",
      "Vibing",
      "Conjuring"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$OSTYPE\" in darwin*) bash \"$HOME/.claude/terminal-session-color.sh\" >/dev/null 2>&1 || true ;; esac"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$OSTYPE\" in darwin*) afplay /System/Library/Sounds/Pop.aiff >/dev/null 2>&1 & ;; msys*|cygwin*) powershell.exe -c \"[console]::beep(880,80)\" >/dev/null 2>&1 & ;; esac; echo '{\"systemMessage\":\"✳ Claude Code\"}'"
          }
        ]
      }
    ]
  }
}
