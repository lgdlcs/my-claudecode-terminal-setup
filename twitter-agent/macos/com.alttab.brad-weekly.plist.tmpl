<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alttab.brad-weekly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/.claude/twitter-agent/brad-weekly.command</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>18</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/twitter-agent/brad-weekly.out</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/twitter-agent/brad-weekly.err</string>
</dict>
</plist>
